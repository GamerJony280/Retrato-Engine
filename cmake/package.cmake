include(CMakePackageConfigHelpers)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/retrato-target.json" "{\"version\":\"${PROJECT_VERSION}\",\"os\":\"${RETRATO_TARGET_OS}\",\"arch\":\"${RETRATO_TARGET_ARCH}\"}\n")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/retrato-target.json" DESTINATION ${CMAKE_INSTALL_DATADIR}/retrato)
set(RETRATO_PACKAGE_SDL OFF)
if(EMBER_OPENGL OR (EMBER_APP AND NOT ANDROID))
 set(RETRATO_PACKAGE_SDL ON)
endif()
set(_package "${CMAKE_INSTALL_LIBDIR}/cmake/Retrato")
configure_package_config_file(cmake/RetratoConfig.cmake.in "${CMAKE_CURRENT_BINARY_DIR}/RetratoConfig.cmake" INSTALL_DESTINATION "${_package}")
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/RetratoConfigVersion.cmake" VERSION "${PROJECT_VERSION}" COMPATIBILITY SameMinorVersion)
install(EXPORT RetratoTargets FILE RetratoTargets.cmake NAMESPACE retrato:: DESTINATION "${_package}")
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/RetratoConfig.cmake" "${CMAKE_CURRENT_BINARY_DIR}/RetratoConfigVersion.cmake" cmake/FindRetratoSDL2.cmake cmake/RetratoApplication.cmake cmake/CopyRuntime.cmake cmake/NovaModule.cmake cmake/RunNova.cmake DESTINATION "${_package}")
install(FILES platform/common/entry.cpp DESTINATION "${_package}/platform/common")
install(FILES cmake/TargetIdentity.cmake DESTINATION "${_package}")
install(FILES platform/windows/game_entry.cpp platform/windows/arguments.hpp DESTINATION "${_package}/platform/windows")
install(FILES platform/android/entry.cpp platform/android/context.hpp DESTINATION "${_package}/platform/android")
