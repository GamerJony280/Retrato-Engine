file(WRITE "${DIR}/spirv_sources.hpp" "#pragma once\n")
foreach(stage IN ITEMS vert frag)
 file(READ "${DIR}/scene.${stage}.spv" DATA HEX)
 string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," DATA "${DATA}")
 if(stage STREQUAL "vert")
  set(NAME vertex)
 else()
  set(NAME fragment)
 endif()
 file(APPEND "${DIR}/spirv_sources.hpp" "alignas(4) static constexpr unsigned char spirv_${NAME}[]={${DATA}};\n")
endforeach()
