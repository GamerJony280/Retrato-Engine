# Prefer SDL's own imported target (also carries Windows/static dependencies).
if(TARGET Retrato::SDL2)
 set(RetratoSDL2_FOUND TRUE)
 set(SDL2_LIBRARY Retrato::SDL2)
 return()
endif()
if(SDL2_INCLUDE_DIR AND EXISTS "${SDL2_INCLUDE_DIR}/SDL.h" AND SDL2_LIBRARY AND EXISTS "${SDL2_LIBRARY}")
 add_library(RetratoSDL2Raw UNKNOWN IMPORTED GLOBAL)
 set_target_properties(RetratoSDL2Raw PROPERTIES IMPORTED_LOCATION "${SDL2_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${SDL2_INCLUDE_DIR}")
 set(_retrato_sdl RetratoSDL2Raw)
else()
 find_package(SDL2 CONFIG QUIET)
endif()
if(_retrato_sdl)
 # Explicit SDK/toolchain override above.
elseif(TARGET SDL2::SDL2)
 set(_retrato_sdl SDL2::SDL2)
elseif(TARGET SDL2::SDL2-static)
 set(_retrato_sdl SDL2::SDL2-static)
else()
 find_path(SDL2_INCLUDE_DIR SDL.h PATH_SUFFIXES SDL2)
 find_library(SDL2_LIBRARY NAMES SDL2 SDL2-2.0)
 if(SDL2_INCLUDE_DIR AND SDL2_LIBRARY)
  add_library(RetratoSDL2Raw UNKNOWN IMPORTED GLOBAL)
  set_target_properties(RetratoSDL2Raw PROPERTIES IMPORTED_LOCATION "${SDL2_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${SDL2_INCLUDE_DIR}")
  set(_retrato_sdl RetratoSDL2Raw)
 endif()
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(RetratoSDL2 REQUIRED_VARS _retrato_sdl)
if(RetratoSDL2_FOUND AND NOT TARGET Retrato::SDL2)
 get_target_property(_sdl_real ${_retrato_sdl} ALIASED_TARGET)
 if(NOT _sdl_real)
  set(_sdl_real ${_retrato_sdl})
 endif()
 get_target_property(_sdl_imported ${_sdl_real} IMPORTED)
 get_target_property(_sdl_dir ${_sdl_real} SOURCE_DIR)
 if(_sdl_imported AND _sdl_dir STREQUAL CMAKE_CURRENT_SOURCE_DIR)
  set_property(TARGET ${_sdl_real} PROPERTY IMPORTED_GLOBAL TRUE)
 endif()
 add_library(Retrato::SDL2 INTERFACE IMPORTED GLOBAL)
 set_target_properties(Retrato::SDL2 PROPERTIES INTERFACE_LINK_LIBRARIES "${_sdl_real}" INTERFACE_COMPILE_DEFINITIONS SDL_MAIN_HANDLED)
endif()
# Compatibility variables for existing external games; prefer Retrato::SDL2.
if(RetratoSDL2_FOUND)
 set(SDL2_LIBRARY Retrato::SDL2)
 if(NOT SDL2_INCLUDE_DIR)
  get_target_property(SDL2_INCLUDE_DIR ${_retrato_sdl} INTERFACE_INCLUDE_DIRECTORIES)
 endif()
endif()
