include_guard(GLOBAL)
# Your sources implement int retrato_game_main(int,char**). Entry points are
# platform files, not copies of the game's logic.
function(retrato_add_game target)
 cmake_parse_arguments(GAME "" "CONTENT_DIR" "SOURCES" ${ARGN})
 if(NOT TARGET retrato::app)
  message(FATAL_ERROR "retrato_add_game requires Retrato built with EMBER_APP=ON")
 endif()
 if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../platform/common/entry.cpp")
  get_filename_component(_platform "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../platform" ABSOLUTE)
 else()
  set(_platform "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/platform")
 endif()
 if(ANDROID)
  add_library(${target} SHARED ${GAME_SOURCES} "${_platform}/android/entry.cpp")
  target_include_directories(${target} PRIVATE "${CMAKE_ANDROID_NDK}/sources/android/native_app_glue")
 elseif(WIN32)
  add_executable(${target} ${GAME_SOURCES} "${_platform}/windows/game_entry.cpp")
  if(MINGW)
   target_link_options(${target} PRIVATE -municode)
  endif()
 else()
  add_executable(${target} ${GAME_SOURCES} "${_platform}/common/entry.cpp")
 endif()
 if(WIN32)
  target_compile_options(${target} PRIVATE $<$<CXX_COMPILER_ID:MSVC>:/utf-8>)
  if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.21)
   add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}" "-DDLLS=$<TARGET_RUNTIME_DLLS:${target}>" "-DOUTPUT=$<TARGET_FILE_DIR:${target}>" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/CopyRuntime.cmake" VERBATIM)
  endif()
 endif()
 target_link_libraries(${target} PRIVATE retrato::app)
 if(GAME_CONTENT_DIR AND NOT ANDROID)
  # Also refresh when only a config/asset changed and the executable is up to date.
  add_custom_target(${target}_content COMMAND "${CMAKE_COMMAND}" -E make_directory "$<TARGET_FILE_DIR:${target}>/content" COMMAND "${CMAKE_COMMAND}" -E copy_directory "${GAME_CONTENT_DIR}" "$<TARGET_FILE_DIR:${target}>/content" VERBATIM)
  add_dependencies(${target} ${target}_content)
 endif()
endfunction()
