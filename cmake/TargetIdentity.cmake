include_guard(GLOBAL)
# Compiler target, not host CPU. Reused by source builds and installed SDKs.
function(retrato_detect_target output_os output_arch)
 if(ANDROID)
  set(os android)
 elseif(WIN32)
  set(os windows)
 elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  set(os linux)
 else()
  message(FATAL_ERROR "No Retrato adapter for target system ${CMAKE_SYSTEM_NAME}")
 endif()
 if(NOT CMAKE_CXX_COMPILER_LOADED)
  message(FATAL_ERROR "Retrato requires CXX enabled in the consumer project")
 endif()
 include(CheckCXXSourceCompiles)
 set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
 set(arch "")
 foreach(candidate arm64 x86_64 armv7 x86)
  if(candidate STREQUAL "arm64")
   set(expression "defined(__aarch64__) || defined(_M_ARM64)")
  elseif(candidate STREQUAL "x86_64")
   set(expression "defined(__x86_64__) || defined(_M_X64)")
  elseif(candidate STREQUAL "armv7")
   set(expression "(defined(__arm__) && __ARM_ARCH >= 7) || defined(_M_ARM)")
  else()
   set(expression "defined(__i386__) || defined(_M_IX86)")
  endif()
  check_cxx_source_compiles("#if !(${expression})\n#error other architecture\n#endif\nint main(){return 0;}" RETRATO_COMPILER_${candidate})
  if(RETRATO_COMPILER_${candidate})
   set(arch ${candidate})
   break()
  endif()
 endforeach()
 if(NOT arch)
  message(FATAL_ERROR "Target architecture is not one of x86, x86_64, armv7, arm64")
 endif()
 if(CMAKE_CXX_BYTE_ORDER STREQUAL "BIG_ENDIAN")
  message(FATAL_ERROR "Retrato currently requires a little-endian target")
 endif()
 set(${output_os} "${os}" PARENT_SCOPE)
 set(${output_arch} "${arch}" PARENT_SCOPE)
endfunction()

function(retrato_validate_sdk_target sdk_os sdk_arch)
 retrato_detect_target(actual_os actual_arch)
 if(NOT sdk_os STREQUAL actual_os OR NOT sdk_arch STREQUAL actual_arch)
  message(FATAL_ERROR "Retrato SDK is ${sdk_os}-${sdk_arch}; compiler target is ${actual_os}-${actual_arch}. Use an SDK built for this target.")
 endif()
 if(DEFINED RETRATO_EXPECT_ARCH AND NOT RETRATO_EXPECT_ARCH STREQUAL sdk_arch)
  message(FATAL_ERROR "Retrato SDK is ${sdk_arch}, project requests ${RETRATO_EXPECT_ARCH}")
 endif()
endfunction()
