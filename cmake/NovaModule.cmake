include_guard(GLOBAL)
set(NOVA_HOST_COMPILER "" CACHE FILEPATH "Nova compiler that runs on this build computer")
function(_nova_requires_host output)
 set(cross ${CMAKE_CROSSCOMPILING})
 string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" host_arch)
 # CMake may keep CROSSCOMPILING=false for -A ARM64 on Windows x64.
 if(WIN32 AND CMAKE_GENERATOR_PLATFORM MATCHES "^[Aa][Rr][Mm]64$" AND NOT host_arch MATCHES "^(arm64|aarch64)$")
  set(cross TRUE)
 endif()
 set(${output} ${cross} PARENT_SCOPE)
endfunction()
function(nova_add_module target source)
 _nova_requires_host(_nova_cross)
 get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
 if(NOVA_HOST_COMPILER)
  if(NOT EXISTS "${NOVA_HOST_COMPILER}")
   message(FATAL_ERROR "NOVA_HOST_COMPILER does not exist: ${NOVA_HOST_COMPILER}")
  endif()
  set(compiler "${NOVA_HOST_COMPILER}")
  set(compiler_dependency "${NOVA_HOST_COMPILER}")
 elseif(_nova_cross)
  message(FATAL_ERROR "Cross compilation needs a HOST Nova compiler. Use tools/build.py or set NOVA_HOST_COMPILER.")
 elseif(TARGET nova)
  set(compiler "$<TARGET_FILE:nova>")
  set(compiler_dependency nova)
 elseif(TARGET retrato::nova)
  set(compiler "$<TARGET_FILE:retrato::nova>")
  set(compiler_dependency retrato::nova)
 else()
  message(FATAL_ERROR "Nova is optional and was not installed. Build an SDK with EMBER_NOVA=ON or provide NOVA_HOST_COMPILER.")
 endif()
 set(output "${CMAKE_CURRENT_BINARY_DIR}/${target}.generated.cpp")
 add_custom_command(OUTPUT "${output}" COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=${compiler}" "-DSOURCE=${source}" "-DOUTPUT=${output}" "-DDEPFILE=${output}.d" -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunNova.cmake" DEPFILE "${output}.d" DEPENDS ${compiler_dependency} "${source}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunNova.cmake" VERBATIM)
 add_custom_target(${target} DEPENDS "${output}")
 set(${target}_SOURCE "${output}" PARENT_SCOPE)
endfunction()
