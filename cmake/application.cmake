if(ANDROID)
 set(_glue "${CMAKE_ANDROID_NDK}/sources/android/native_app_glue")
 if(NOT EXISTS "${_glue}/android_native_app_glue.c")
  message(FATAL_ERROR "Android NDK native_app_glue was not found")
 endif()
 add_library(retrato_android_glue STATIC "${_glue}/android_native_app_glue.c")
 set_target_properties(retrato_android_glue PROPERTIES POSITION_INDEPENDENT_CODE ON)
 target_include_directories(ember PRIVATE "${_glue}")
 target_link_libraries(ember PRIVATE android)
 add_library(ember_app STATIC platform/common/application.cpp platform/android/application.cpp)
 target_include_directories(ember_app PRIVATE "${_glue}")
 target_link_libraries(ember_app PRIVATE retrato_android_glue android log)
 install(TARGETS retrato_android_glue EXPORT RetratoTargets)
else()
 add_library(ember_app STATIC platform/common/application.cpp platform/common/sdl_application.cpp)
 target_link_libraries(ember_app PRIVATE Retrato::SDL2)
endif()
if(EMBER_OPENGL)
 target_compile_definitions(ember_app PRIVATE EMBER_OPENGL)
endif()
if(EMBER_VULKAN)
 target_compile_definitions(ember_app PRIVATE EMBER_VULKAN)
 if(NOT ANDROID)
  target_include_directories(ember_app PRIVATE "${Vulkan_INCLUDE_DIRS}")
 endif()
endif()
set_target_properties(ember_app PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME app)
target_link_libraries(ember_app PUBLIC ember)
add_library(retrato::app ALIAS ember_app)
install(TARGETS ember_app EXPORT RetratoTargets)
include("${CMAKE_CURRENT_LIST_DIR}/RetratoApplication.cmake")
if(EMBER_TESTS AND NOT ANDROID)
 add_executable(ember_presentation_tests tests/presentation_tests.cpp)
 target_link_libraries(ember_presentation_tests PRIVATE ember_app Retrato::SDL2)
 add_test(NAME ember_presentation_cpu COMMAND ember_presentation_tests cpu)
 set_tests_properties(ember_presentation_cpu PROPERTIES ENVIRONMENT "SDL_VIDEODRIVER=dummy")
 add_executable(ember_application_tests tests/application_tests.cpp)
 target_link_libraries(ember_application_tests PRIVATE ember_app)
 add_test(NAME ember_application_tests COMMAND ember_application_tests)
 retrato_add_game(ember_entry_tests SOURCES tests/entry_tests.cpp)
 add_test(NAME ember_entry_unicode COMMAND ember_entry_tests "archivo árbol-東京.glb")
 add_executable(ember_application_input_tests tests/application_input_tests.cpp)
 target_link_libraries(ember_application_input_tests PRIVATE ember_app Retrato::SDL2)
 add_test(NAME ember_application_input_tests COMMAND ember_application_input_tests)
 set_tests_properties(ember_application_input_tests PROPERTIES ENVIRONMENT "SDL_VIDEODRIVER=dummy")
endif()
