if(NOT EMBER_VULKAN)
 return()
endif()
if(ANDROID)
 if(CMAKE_SYSTEM_VERSION VERSION_LESS 24)
  message(FATAL_ERROR "Vulkan requires Android API 24+; select android-24 or newer")
 endif()
 set(Vulkan_FOUND TRUE)
else()
 find_package(Vulkan QUIET)
 if(NOT Vulkan_FOUND)
  # Runtime loading needs headers at build time, not a loader import library.
  find_path(Vulkan_INCLUDE_DIR vulkan/vulkan.h HINTS "$ENV{VULKAN_SDK}/Include" "$ENV{VULKAN_SDK}/include")
  if(Vulkan_INCLUDE_DIR)
   set(Vulkan_INCLUDE_DIRS "${Vulkan_INCLUDE_DIR}")
   set(Vulkan_FOUND TRUE)
  endif()
 endif()
endif()
if(NOT Vulkan_FOUND)
 message(WARNING "Vulkan development files not found; Vulkan backend omitted (CPU remains available)")
 set(EMBER_VULKAN OFF)
 return()
endif()
set(_precompiled "${CMAKE_CURRENT_SOURCE_DIR}/shaders/precompiled")
set(_valid TRUE)
if(EXISTS "${_precompiled}/hashes.cmake")
 include("${_precompiled}/hashes.cmake")
 foreach(_stage vert frag)
  string(TOUPPER "${_stage}" _upper)
  file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/shaders/scene.${_stage}" _source)
  if(NOT EXISTS "${_precompiled}/scene.${_stage}.spv")
   set(_valid FALSE)
  else()
   file(SHA256 "${_precompiled}/scene.${_stage}.spv" _binary)
   if(NOT _source STREQUAL RETRATO_${_upper}_SOURCE_SHA256 OR NOT _binary STREQUAL RETRATO_${_upper}_SPIRV_SHA256)
    set(_valid FALSE)
   endif()
  endif()
 endforeach()
else()
 set(_valid FALSE)
endif()
if(_valid)
 foreach(stage vert frag)
  configure_file("${_precompiled}/scene.${stage}.spv" "${CMAKE_CURRENT_BINARY_DIR}/generated/scene.${stage}.spv" COPYONLY)
 endforeach()
 # The embedded packet is regenerated only after source/binary hash checks.
 set(DIR "${CMAKE_CURRENT_BINARY_DIR}/generated")
 include("${CMAKE_CURRENT_SOURCE_DIR}/cmake/embed_spirv.cmake")
 unset(DIR)
 set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS shaders/precompiled/hashes.cmake shaders/precompiled/scene.vert.spv shaders/precompiled/scene.frag.spv)
else()
 find_program(GLSLANG glslangValidator)
 if(NOT GLSLANG)
  message(FATAL_ERROR "GLSL changed or cached SPIR-V is invalid. Install glslangValidator or regenerate shaders with tools/compile_shaders.py; stale shaders will not be used.")
 endif()
 add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/spirv_sources.hpp"
  COMMAND "${GLSLANG}" -V "${CMAKE_CURRENT_SOURCE_DIR}/shaders/scene.vert" -o "${CMAKE_CURRENT_BINARY_DIR}/generated/scene.vert.spv"
  COMMAND "${GLSLANG}" -V "${CMAKE_CURRENT_SOURCE_DIR}/shaders/scene.frag" -o "${CMAKE_CURRENT_BINARY_DIR}/generated/scene.frag.spv"
  COMMAND "${CMAKE_COMMAND}" -DDIR=${CMAKE_CURRENT_BINARY_DIR}/generated -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/embed_spirv.cmake"
  DEPENDS shaders/scene.vert shaders/scene.frag cmake/embed_spirv.cmake VERBATIM)
endif()
target_sources(ember PRIVATE src/render/vulkan.cpp src/render/vulkan_window.cpp "${CMAKE_CURRENT_BINARY_DIR}/generated/spirv_sources.hpp")
if(WIN32)
 target_sources(ember PRIVATE platform/windows/shared_library.cpp)
else()
 target_sources(ember PRIVATE platform/common/posix_shared_library.cpp)
endif()
if(NOT ANDROID)
 target_include_directories(ember PRIVATE "${Vulkan_INCLUDE_DIRS}")
endif()
target_link_libraries(ember PRIVATE ${CMAKE_DL_LIBS})
target_compile_definitions(ember PRIVATE EMBER_VULKAN)
if(NOT MSVC)
 set_source_files_properties(src/render/vulkan.cpp src/render/vulkan_window.cpp PROPERTIES COMPILE_OPTIONS "-Wno-missing-field-initializers")
endif()
