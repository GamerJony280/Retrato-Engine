if(EMBER_OPENGL)
 find_package(OpenGL QUIET)
 if(OpenGL_FOUND)
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/shaders/scene.vert" VERTEX)
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/shaders/scene.frag" FRAGMENT)
  string(REPLACE "#version 450" "#version 330 core\n#define EMBER_GL" VERTEX "${VERTEX}")
  string(REPLACE "#version 450" "#version 330 core\n#define EMBER_GL" FRAGMENT "${FRAGMENT}")
  string(REGEX REPLACE "layout\\(location=[0-9]+\\) flat out" "flat out" VERTEX "${VERTEX}")
  string(REGEX REPLACE "layout\\(location=[0-9]+\\) out" "out" VERTEX "${VERTEX}")
  string(REGEX REPLACE "layout\\(location=[0-9]+\\) flat in" "flat in" FRAGMENT "${FRAGMENT}")
  string(REGEX REPLACE "layout\\(location=[0-9]+\\) in" "in" FRAGMENT "${FRAGMENT}")
  configure_file(cmake/shader_sources.hpp.in generated/shader_sources.hpp @ONLY)
  target_sources(ember PRIVATE src/render/opengl.cpp)
  target_link_libraries(ember PRIVATE OpenGL::GL)
  target_compile_definitions(ember PRIVATE EMBER_OPENGL)
 else()
  message(WARNING "EMBER_OPENGL=ON but OpenGL development files were not found; building without OpenGL")
  set(EMBER_OPENGL OFF)
 endif()
endif()
