@PACKAGE_INIT@
set(Retrato_TARGET_OS "@RETRATO_TARGET_OS@")
set(Retrato_TARGET_ARCH "@RETRATO_TARGET_ARCH@")
include("${CMAKE_CURRENT_LIST_DIR}/TargetIdentity.cmake")
# Reject a foreign SDK before resolving dependencies or linking its objects.
retrato_validate_sdk_target("${Retrato_TARGET_OS}" "${Retrato_TARGET_ARCH}")
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(_retrato_module_path "${CMAKE_MODULE_PATH}")
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
if(@RETRATO_PACKAGE_SDL@)
 find_dependency(RetratoSDL2)
endif()
if(@EMBER_OPENGL@)
 find_dependency(OpenGL)
endif()
if(@EMBER_LUA@)
 find_dependency(Lua 5.4)
 if(NOT TARGET Retrato::Lua)
  add_library(Retrato::Lua INTERFACE IMPORTED)
  set_target_properties(Retrato::Lua PROPERTIES INTERFACE_LINK_LIBRARIES "${LUA_LIBRARIES}" INTERFACE_INCLUDE_DIRECTORIES "${LUA_INCLUDE_DIR}")
 endif()
endif()
if(@EMBER_JOLT@)
 find_dependency(Jolt CONFIG)
 if(NOT TARGET Jolt::Jolt AND TARGET Jolt)
  add_library(Jolt::Jolt ALIAS Jolt)
 endif()
endif()
set(CMAKE_MODULE_PATH "${_retrato_module_path}")
include("${CMAKE_CURRENT_LIST_DIR}/RetratoTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/RetratoApplication.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/NovaModule.cmake")
set(Retrato_VERSION "@PROJECT_VERSION@")
set(Retrato_WITH_LUA @EMBER_LUA@)
set(Retrato_WITH_VULKAN @EMBER_VULKAN@)
set(Retrato_WITH_OPENGL @EMBER_OPENGL@)
check_required_components(Retrato)
