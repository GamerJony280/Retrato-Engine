file(MAKE_DIRECTORY "${TEST_DIR}")
file(WRITE "${TEST_DIR}/shared.nova" "var score: int=1\n")
file(WRITE "${TEST_DIR}/main.nova" "import \"shared.nova\"\nfunc get_score() -> int { return score }\n")
file(SHA256 "${TEST_DIR}/shared.nova" before)
execute_process(COMMAND "${NOVA}" --emit-cpp "${TEST_DIR}/main.nova" -o "${TEST_DIR}/shared.nova" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "overwrite a source")
 message(FATAL_ERROR "CLI did not protect imported source: ${error}")
endif()
file(SHA256 "${TEST_DIR}/shared.nova" after)
if(NOT before STREQUAL after)
 message(FATAL_ERROR "CLI altered imported source")
endif()
execute_process(COMMAND "${NOVA}" --emit-cpp "${TEST_DIR}/main.nova" -o "${TEST_DIR}/out.cpp" --depfile "${TEST_DIR}/main.nova" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "overwrite a source")
 message(FATAL_ERROR "CLI did not protect input from dependency output: ${error}")
endif()
execute_process(COMMAND "${NOVA}" --emit-cpp "${TEST_DIR}/main.nova" -o "${TEST_DIR}/out.cpp" --depfile "${TEST_DIR}/out.d" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "CLI emit failed")
endif()
file(READ "${TEST_DIR}/out.d" deps)
if(NOT deps MATCHES "shared.nova")
 message(FATAL_ERROR "Import missing from depfile")
endif()
file(SHA256 "${TEST_DIR}/out.cpp" before)
file(WRITE "${TEST_DIR}/shared.nova" "var score: int=missing\n")
execute_process(COMMAND "${NOVA}" --emit-cpp "${TEST_DIR}/main.nova" -o "${TEST_DIR}/out.cpp" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "shared.nova:1")
 message(FATAL_ERROR "Imported diagnostics lost source mapping")
endif()
file(SHA256 "${TEST_DIR}/out.cpp" after)
if(NOT before STREQUAL after)
 message(FATAL_ERROR "Failed compilation replaced previous output")
endif()
file(REMOVE_RECURSE "${TEST_DIR}")
