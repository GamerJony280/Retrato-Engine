include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/NovaModule.cmake")
set(CMAKE_CROSSCOMPILING FALSE)
set(WIN32 TRUE)
set(CMAKE_GENERATOR_PLATFORM ARM64)
set(CMAKE_HOST_SYSTEM_PROCESSOR AMD64)
_nova_requires_host(cross)
if(NOT cross)
 message(FATAL_ERROR "Windows x64 -> ARM64 must use a host compiler even when CMake CROSSCOMPILING is false")
endif()
set(CMAKE_HOST_SYSTEM_PROCESSOR ARM64)
_nova_requires_host(cross)
if(cross)
 message(FATAL_ERROR "Native Windows ARM64 incorrectly classified as cross")
endif()
set(WIN32 FALSE)
set(CMAKE_CROSSCOMPILING TRUE)
_nova_requires_host(cross)
if(NOT cross)
 message(FATAL_ERROR "Linux/Android cross build lost host separation")
endif()
# CMake is deliberately not Nova: protocol validation must reject it early.
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=${CMAKE_COMMAND}" -P "${CMAKE_CURRENT_LIST_DIR}/../../cmake/RunNova.cmake" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "HOST Nova compiler is incompatible")
 message(FATAL_ERROR "Incompatible host compiler was not diagnosed")
endif()
