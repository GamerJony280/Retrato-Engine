{
  "version": 3,
  "configurePresets": [
    {
      "name": "cpu",
      "displayName": "CPU con importadores incluidos, sin dependencias del sistema",
      "binaryDir": "${sourceDir}/build/cpu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF",
        "EMBER_OPENGL": "OFF",
        "EMBER_VULKAN": "OFF",
        "EMBER_LUA": "OFF",
        "EMBER_VIEWER": "OFF",
        "EMBER_RMLUI": "OFF",
        "EMBER_JOLT": "OFF"
      }
    },
    {
      "name": "editor",
      "displayName": "Editor SDL2 + CPU, sin Lua ni GPU",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/editor",
      "cacheVariables": {
        "EMBER_VIEWER": "ON",
        "EMBER_NOVA": "OFF"
      }
    },
    {
      "name": "desktop",
      "displayName": "CPU + Vulkan + OpenGL + Lua + RmlUi",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SHARED_LIBS": "OFF",
        "EMBER_OPENGL": "ON",
        "EMBER_VULKAN": "ON",
        "EMBER_LUA": "ON",
        "EMBER_VIEWER": "ON",
        "EMBER_RMLUI": "ON",
        "EMBER_JOLT": "OFF"
      }
    },
    {
      "name": "runtime",
      "displayName": "CPU m\u00ednimo: recursos precocinados, sin importadores",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/runtime",
      "cacheVariables": {
        "EMBER_IMPORTERS": "OFF",
        "EMBER_TOOLS": "OFF",
        "EMBER_EXAMPLES": "OFF",
        "EMBER_VFX": "OFF",
        "EMBER_NOVA": "OFF",
        "EMBER_TESTS": "OFF"
      }
    },
    {
      "name": "runtime-tests",
      "displayName": "Validate minimal runtime without importers or tools",
      "inherits": "runtime",
      "binaryDir": "${sourceDir}/build/runtime-tests",
      "cacheVariables": {
        "EMBER_TESTS": "ON"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "cacheVariables": {
        "EMBER_VULKAN": "ON",
        "EMBER_VIEWER": "ON",
        "EMBER_APP": "ON",
        "EMBER_OPENGL": "OFF",
        "RETRATO_EXPECT_ARCH": "x86_64"
      }
    },
    {
      "name": "linux-arm64-native",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/linux-arm64-native",
      "cacheVariables": {
        "RETRATO_EXPECT_ARCH": "arm64"
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/linux-arm64",
      "cacheVariables": {
        "RETRATO_EXPECT_ARCH": "arm64"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64.cmake"
    },
    {
      "name": "linux-x86",
      "inherits": "cpu",
      "binaryDir": "${sourceDir}/build/linux-x86",
      "cacheVariables": {
        "RETRATO_EXPECT_ARCH": "x86"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x86.cmake"
    },
    {
