body { width: 100%; height: 100%; font-family: DejaVu Sans; font-size: 14px; color: #dae9ef; }
div, p, h1 { display: block; }
p, h1 { margin: 0px; }
#panel { position: absolute; left: 22px; top: 22px; width: 214px; padding: 18px; background-color: #101b25ed; border-width: 1px; border-color: #354957; }
.eyebrow { font-size: 10px; color: #84a4b6; margin-bottom: 8px; }
h1 { font-size: 38px; margin: 0px; }
.accent { color: #ff9e59; }
.subtitle { color: #9eb6c3; margin-top: 4px; font-size: 12px; }
.rule { height: 1px; background-color: #354957; margin-top: 10px; margin-bottom: 10px; }
.label { font-size: 10px; color: #84a4b6; margin-bottom: 8px; }
button { display: block; width: 194px; padding: 8px; margin-bottom: 5px; background-color: #243744; color: #dae9ef; border-width: 1px; border-color: #354957; }
button:hover { background-color: #365364; border-color: #90b4c7; }
button:active { background-color: #80532d; }
.secondary { background-color: #182936; }
#status { font-size: 11px; color: #ffb47d; margin-top: 10px; }
#footer { position: absolute; bottom: 18px; left: 300px; padding: 8px; background-color: #101b25df; font-size: 11px; }
