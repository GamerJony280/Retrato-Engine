if(NOT ROOT OR NOT TEST_DIR MATCHES "/sdl-import-tests$")
 message(FATAL_ERROR "Expected ROOT and isolated TEST_DIR")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run)
set(TEST_DIR "${TEST_DIR}/${run}")
foreach(mode raw child parent)
 set(source "${TEST_DIR}/${mode}")
 file(MAKE_DIRECTORY "${source}/child" "${source}/headers")
 file(WRITE "${source}/headers/SDL.h" "/* configure fixture */")
 file(WRITE "${source}/libSDL.a" "")
 set(setup "")
 set(child "list(APPEND CMAKE_MODULE_PATH \"${ROOT}/cmake\")\n")
 if(mode STREQUAL raw)
  string(APPEND child "set(SDL2_INCLUDE_DIR \"${source}/headers\")\nset(SDL2_LIBRARY \"${source}/libSDL.a\")\n")
 elseif(mode STREQUAL child)
  string(APPEND child "add_library(SDL2Real INTERFACE IMPORTED)\nadd_library(SDL2::SDL2 ALIAS SDL2Real)\n")
 else()
  set(setup "add_library(SDL2Real INTERFACE IMPORTED)\nadd_library(SDL2::SDL2 ALIAS SDL2Real)\n")
 endif()
 string(APPEND child "find_package(RetratoSDL2 REQUIRED)\n")
 file(WRITE "${source}/child/CMakeLists.txt" "${child}")
 file(WRITE "${source}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.20)\nproject(SDLContract LANGUAGES C CXX)\n${setup}add_subdirectory(child)\nif(NOT TARGET Retrato::SDL2)\nmessage(FATAL_ERROR \"SDL target invisible in consumer scope\")\nendif()\nadd_library(consumer INTERFACE)\ntarget_link_libraries(consumer INTERFACE Retrato::SDL2)\n")
 set(args -S "${source}" -B "${source}/build" -G "${GENERATOR}" "-DCMAKE_C_COMPILER=${CC}" "-DCMAKE_CXX_COMPILER=${CXX}")
 if(PLATFORM)
  list(APPEND args -A "${PLATFORM}")
 endif()
 if(TOOLSET)
  list(APPEND args -T "${TOOLSET}")
 endif()
 execute_process(COMMAND "${CMAKE_COMMAND}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "SDL imported target contract ${mode}: ${out}\n${err}")
 endif()
endforeach()
message(STATUS "PASS: SDL raw, child alias and inherited imported targets")
